// Axis platform — core data model
//
// Database: MongoDB (replica set — required for transactions).
//
// Tenancy rule: every tenant-owned model carries `tenantId`. MongoDB has no row-level
// security, so isolation is enforced by the tenant guard in apps/api
// (src/prisma/tenant-guard.ts): every query on a tenant model is filtered to the
// current tenant, writes for another tenant are rejected, and a query without
// tenant context matches nothing.
//
// Indexes are NOT created by `prisma db push`: unique fields that may be null need
// partial indexes, which Prisma can't express. They are defined in
// scripts/indexes.mjs; the @@unique attributes below only shape the Prisma client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Platform level (not tenant-scoped)
// ─────────────────────────────────────────────────────────────

enum PlatformRole {
  NONE
  SUPPORT
  SUPER_ADMIN
}

model User {
  id               String       @id @default(cuid()) @map("_id")
  email            String       @unique
  passwordHash     String?
  fullName         String
  avatarUrl        String?
  locale           Locale       @default(AZ)
  platformRole     PlatformRole @default(NONE)
  emailVerified    DateTime?
  // Platform staff 2FA: sealed TOTP key (common/secrets); enabled once a code was confirmed
  mfaSecret        String?
  mfaEnabledAt     DateTime?
  // Last accepted TOTP step — a code can't be used twice
  mfaLastStep      Int?
  // sha256 of one-time recovery codes
  mfaRecoveryCodes String[]
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  memberships    Membership[]
  sessions       Session[]
  adminSessions  AdminSession[]
  passwordResets PasswordReset[]
}

// Platform staff sign-in (Super Admin). Separate from tenant sessions: different
// token issuer, no tenant, checked on every admin request so logout is immediate.
model AdminSession {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per refresh token. Rotation creates a new row in the same family;
// presenting an already-rotated token revokes the whole family (theft detection).
model Session {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  tenantId  String // workspace the token is issued for
  familyId  String
  tokenHash String    @unique // sha256 of the refresh token
  userAgent String?
  ip        String?
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum Locale {
  AZ
  EN
  RU
}

enum TenantStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model Tenant {
  id          String       @id @default(cuid()) @map("_id")
  slug        String       @unique // subdomain: <slug>.axis.az
  name        String
  logoUrl     String?
  timezone    String       @default("Asia/Baku")
  currency    String       @default("AZN")
  locale      Locale       @default(AZ)
  status      TenantStatus @default(TRIALING)
  // Bumped inside transactions that must not run concurrently (e.g. owner changes):
  // MongoDB aborts one of two transactions writing the same document.
  lockVersion Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships      Membership[]
  departments      Department[]
  subscription     Subscription?
  invoices         Invoice[]
  usage            UsageCounter[]
  contacts         Contact[]
  pipelines        Pipeline[]
  deals            Deal[]
  tasks            Task[]
  projects         Project[]
  channels         Channel[]
  conversations    Conversation[]
  chatRooms        ChatRoom[]
  files            FileObject[]
  auditLogs        AuditLog[]
  tickets          SupportTicket[]
  ticketMessages   SupportTicketMessage[]
  automationRules  AutomationRule[]
  automationEvents AutomationEvent[]
  automationRuns   AutomationRun[]
}

// ─────────────────────────────────────────────────────────────
// Billing (plans are platform-level, editable by Super Admin)
// ─────────────────────────────────────────────────────────────

model Plan {
  id                  String   @id @default(cuid()) @map("_id")
  code                String   @unique // START | PRO | BUSINESS
  name                String
  priceMonthly        Int // minor units (qəpik): 3900 = 39.00 AZN
  priceYearly         Int
  currency            String   @default("AZN")
  seatLimit           Int
  storageMb           Int
  aiCredits           Int      @default(0)
  // Add-on prices (minor units per month)
  extraSeatPrice      Int      @default(900)
  extraStorageGbPrice Int      @default(500)
  // Feature flags, e.g. ["crm.basic","tasks","team_chat","inbox.webchat"]
  features            String[]
  isPublic            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE // payment failed, in grace period
  SUSPENDED // grace period over, read-only access
  CANCELED
}

enum BillingInterval {
  MONTH
  YEAR
}

model Subscription {
  id                  String             @id @default(cuid()) @map("_id")
  tenantId            String             @unique
  planId              String
  status              SubscriptionStatus @default(TRIALING)
  interval            BillingInterval    @default(MONTH)
  extraSeats          Int                @default(0)
  extraStorageMb      Int                @default(0)
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  graceEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  // Pending downgrade applied at period end
  scheduledPlanId     String?
  providerRef         String? // payment provider subscription / card token id
  paymentMethod       Json? // { brand, last4 } — display only, never card data
  // Failed renewal: retries on days 1, 3, 5 of the grace period
  retryCount          Int                @default(0)
  nextRetryAt         DateTime?
  trialReminderSentAt DateTime?
  // Demo provider only: the next automatic charge is declined (to try the dunning flow)
  demoNextChargeFails Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  FAILED
  VOID
}

model Invoice {
  id          String        @id @default(cuid()) @map("_id")
  tenantId    String
  number      String        @unique
  kind        String        @default("subscription") // subscription | upgrade | renewal | addons
  status      InvoiceStatus @default(OPEN)
  amount      Int // minor units
  currency    String        @default("AZN")
  periodStart DateTime
  periodEnd   DateTime
  lines       Json // InvoiceLineDto[]
  // Applied to the subscription when paid: { planId, interval, periodStart, periodEnd, extraSeats, extraStorageMb, status }
  apply       Json?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId, createdAt])
}

model Payment {
  id          String   @id @default(cuid()) @map("_id")
  tenantId    String
  invoiceId   String
  provider    String // "payriff" | "epoint" | "manual" ...
  providerRef String
  amount      Int
  status      String // "succeeded" | "failed" | "refunded"
  failureCode String?
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
}

model UsageCounter {
  id       String   @id @default(cuid()) @map("_id")
  tenantId String
  metric   String // "seats" | "storage_mb" | "ai_credits" | "messages"
  period   DateTime // first day of the billing month
  value    Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, period])
}

/// Platform-wide sequences (invoice numbers)
model Counter {
  id    String @id @map("_id") // e.g. "invoice:2026"
  value Int    @default(0)
}

model PlatformExpense {
  id         String   @id @default(cuid()) @map("_id")
  category   String // "api" | "ai" | "server" | "sms" | "other"
  vendor     String
  amount     Int
  currency   String   @default("AZN")
  incurredOn DateTime
  note       String?
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Organisation: members, roles, departments
// ─────────────────────────────────────────────────────────────

enum MemberRole {
  OWNER // company owner: everything, incl. billing
  ADMIN // everything except billing ownership transfer
  MANAGER // sees own department's data
  EMPLOYEE // sees own + explicitly shared data
}

enum MemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Membership {
  id           String       @id @default(cuid()) @map("_id")
  tenantId     String
  userId       String
  role         MemberRole   @default(EMPLOYEE)
  status       MemberStatus @default(INVITED)
  departmentId String?
  title        String?
  // Fine-grained overrides on top of the role, e.g. ["deals.view_all","-inbox.reply"]
  permissions  String[]
  inviteToken  String?      @unique // sha256 of the secret part of the invite link
  invitedAt    DateTime?
  joinedAt     DateTime?
  createdAt    DateTime     @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headOf     Department[] @relation("DepartmentHead")

  @@unique([tenantId, userId])
  @@index([tenantId, departmentId])
}

model Department {
  id       String  @id @default(cuid()) @map("_id")
  tenantId String
  name     String
  headId   String?
  parentId String?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // NoAction breaks the Membership ↔ Department cycle (required on MongoDB); members are disabled, never deleted
  head     Membership?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Department[] @relation("DepartmentTree")
  members  Membership[] @relation("DepartmentMembers")

  @@unique([tenantId, name])
}

// ─────────────────────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────────────────────

enum LifecycleStage {
  LEAD
  QUALIFIED
  CUSTOMER
  CHURNED
}

model Contact {
  id           String         @id @default(cuid()) @map("_id")
  tenantId     String
  ownerId      String? // Membership id
  type         String         @default("person") // "person" | "company"
  name         String
  email        String?
  phone        String? // E.164
  companyName  String?
  stage        LifecycleStage @default(LEAD)
  source       String? // "whatsapp" | "instagram" | "website" | "manual" ...
  tags         String[]
  customFields Json           @default("{}")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deals         Deal[]
  conversations Conversation[]
  activities    Activity[]

  @@index([tenantId, stage])
  @@index([tenantId, ownerId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model Pipeline {
  id        String  @id @default(cuid()) @map("_id")
  tenantId  String
  name      String
  isDefault Boolean @default(false)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]
  deals  Deal[]
}

model PipelineStage {
  id          String @id @default(cuid()) @map("_id")
  tenantId    String
  pipelineId  String
  name        String
  order       Int
  probability Int    @default(0) // 0..100, used for forecast
  kind        String @default("open") // "open" | "won" | "lost"

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, order])
}

model Deal {
  id            String    @id @default(cuid()) @map("_id")
  tenantId      String
  pipelineId    String
  stageId       String
  contactId     String?
  ownerId       String?
  title         String
  amount        Int       @default(0) // minor units
  currency      String    @default("AZN")
  expectedClose DateTime?
  closedAt      DateTime?
  lostReason    String?
  position      Float     @default(0) // kanban ordering inside a stage
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  contact  Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, stageId])
  @@index([tenantId, ownerId])
  @@index([tenantId, closedAt])
}

// Unified timeline for a contact: notes, calls, stage changes, messages, tasks
model Activity {
  id        String   @id @default(cuid()) @map("_id")
  tenantId  String
  contactId String?
  dealId    String?
  actorId   String? // Membership id, null = system
  type      String // "note" | "call" | "stage_changed" | "message" | "task_done" ...
  payload   Json
  createdAt DateTime @default(now())

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Tasks & projects
// ─────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id        String   @id @default(cuid()) @map("_id")
  tenantId  String
  name      String
  ownerId   String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks  Task[]
}

model Task {
  id                String     @id @default(cuid()) @map("_id")
  tenantId          String
  projectId         String?
  parentId          String? // subtasks
  title             String
  description       String?
  status            TaskStatus @default(TODO)
  priority          Priority   @default(MEDIUM)
  creatorId         String
  assigneeId        String?
  dueAt             DateTime?
  completedAt       DateTime?
  // When the overdue notice was sent; cleared when the due date moves
  overdueNotifiedAt DateTime?
  // RFC 5545 RRULE subset for recurring tasks, e.g. "FREQ=WEEKLY;INTERVAL=2"
  recurrence        String?
  contactId         String?
  dealId            String?
  position          Float      @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project  Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent   Task?         @relation("Subtasks", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subtasks Task[]        @relation("Subtasks")
  comments TaskComment[]

  @@index([tenantId, assigneeId, status])
  @@index([tenantId, dueAt])
  @@index([tenantId, parentId])
}

model TaskComment {
  id        String   @id @default(cuid()) @map("_id")
  tenantId  String
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// Omnichannel inbox (customer conversations)
// ─────────────────────────────────────────────────────────────

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  WEBCHAT
  EMAIL
}

model Channel {
  id          String      @id @default(cuid()) @map("_id")
  tenantId    String
  type        ChannelType
  name        String
  externalId  String // WABA phone number id, IG account id, page id, widget id
  // Encrypted at rest (AES-256-GCM, CHANNEL_SECRET_KEY); never returned by the API
  credentials Bytes?
  // Demo channels never talk to a provider; the UI labels them "Demo"
  demo        Boolean     @default(false)
  settings    Json        @default("{}") // e.g. { greeting } for website chat
  status      String      @default("connected") // "connected" | "error" | "disconnected"
  createdAt   DateTime    @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([type, externalId])
}

enum ConversationStatus {
  OPEN
  PENDING // waiting for customer
  RESOLVED
}

model Conversation {
  id              String             @id @default(cuid()) @map("_id")
  tenantId        String
  channelId       String
  contactId       String?
  externalThread  String // provider sender id; website chat: sha256(visitor token)
  displayName     String? // profile name from the provider, until a CRM contact is linked
  handle          String? // phone number / IG handle / visitor email
  lastInboundAt   DateTime? // WhatsApp 24 h reply window
  status          ConversationStatus @default(OPEN)
  assigneeId      String?
  departmentId    String?
  unreadCount     Int                @default(0)
  lastMessageAt   DateTime?
  // Set when a customer message arrives and is not yet answered → SLA metrics
  awaitingSince   DateTime?
  firstResponseMs Int?
  // Email channel: subject of the thread and the Message-ID to reply to (threading)
  subject         String?
  emailReplyTo    String?
  createdAt       DateTime           @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([channelId, externalThread])
  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, assigneeId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL_NOTE // visible to team only, never sent to the customer
}

model Message {
  id             String           @id @default(cuid()) @map("_id")
  tenantId       String
  conversationId String
  direction      MessageDirection
  authorId       String? // Membership id for outbound / notes
  body           String?
  attachments    Json             @default("[]")
  externalId     String? // provider message id (idempotency)
  deliveryStatus String? // "sent" | "delivered" | "read" | "failed"
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
}

model CannedResponse {
  id       String  @id @default(cuid()) @map("_id")
  tenantId String
  shortcut String // "/salam"
  body     String
  isShared Boolean @default(true)
  ownerId  String?

  @@unique([tenantId, shortcut])
}

model WebhookEvent {
  id          String    @id @default(cuid()) @map("_id")
  provider    String
  externalId  String // provider event id
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, externalId])
}

// ─────────────────────────────────────────────────────────────
// Internal team chat (strictly separate from customer messages)
// ─────────────────────────────────────────────────────────────

model ChatRoom {
  id           String   @id @default(cuid()) @map("_id")
  tenantId     String
  kind         String // "direct" | "department" | "group"
  name         String?
  departmentId String?  @unique // one room per department, members synced with it
  directKey    String? // direct chats: sorted "memberA:memberB" so a pair has exactly one room
  createdById  String?
  createdAt    DateTime @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members  ChatMember[]
  messages ChatMessage[]

  @@unique([tenantId, directKey])
}

model ChatMember {
  id         String    @id @default(cuid()) @map("_id")
  tenantId   String
  roomId     String
  memberId   String // Membership id
  lastReadAt DateTime?

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, memberId])
  @@index([tenantId, memberId])
}

model ChatMessage {
  id          String    @id @default(cuid()) @map("_id")
  tenantId    String
  roomId      String
  authorId    String
  body        String?
  attachments Json      @default("[]")
  taskId      String? // linked task
  createdAt   DateTime  @default(now())
  editedAt    DateTime?

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Files, notifications, audit, support
// ─────────────────────────────────────────────────────────────

model FileObject {
  id         String   @id @default(cuid()) @map("_id")
  tenantId   String
  uploaderId String
  key        String   @unique // S3 key: tenants/<tenantId>/<yyyy>/<cuid>
  name       String
  mimeType   String
  sizeBytes  Int
  // Polymorphic link: "task" | "deal" | "contact" | "chat" | "message"
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid()) @map("_id")
  tenantId  String
  memberId  String
  type      String // "task_overdue" | "conversation_assigned" ...
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid()) @map("_id")
  tenantId   String?
  actorId    String? // User id
  action     String // "deal.updated" | "member.role_changed" ...
  entityType String
  entityId   String
  diff       Json?
  ip         String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model SupportTicket {
  id        String   @id @default(cuid()) @map("_id")
  tenantId  String
  authorId  String
  subject   String
  body      String
  status    String   @default("open") // "open" | "in_progress" | "closed"
  priority  Priority @default(MEDIUM)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([tenantId, updatedAt])
  @@index([status, updatedAt])
}

/// Conversation on a ticket; `fromStaff` = platform support wrote it
model SupportTicketMessage {
  id        String   @id @default(cuid()) @map("_id")
  tenantId  String
  ticketId  String
  authorId  String
  fromStaff Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Automations (BUSINESS): "when X happens, do Y"
// ─────────────────────────────────────────────────────────────

model AutomationRule {
  id          String    @id @default(cuid()) @map("_id")
  tenantId    String
  name        String
  // "deal.created" | "deal.stage_changed" | "contact.created" | "conversation.created" | "task.overdue"
  trigger     String
  conditions  Json      @default("{}")
  actions     Json // AutomationAction[]
  enabled     Boolean   @default(true)
  createdById String // Membership id
  // Next member index for round-robin assignment
  rrCursor    Int       @default(0)
  runCount    Int       @default(0)
  lastRunAt   DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@index([tenantId, trigger, enabled])
}

/// Outbox: written in the same transaction as the change, processed after commit
model AutomationEvent {
  id          String    @id @default(cuid()) @map("_id")
  tenantId    String
  trigger     String
  payload     Json
  status      String    @default("pending") // "pending" | "processing" | "done" | "failed"
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model AutomationRun {
  id        String   @id @default(cuid()) @map("_id")
  tenantId  String
  ruleId    String
  eventId   String
  status    String // "success" | "skipped" | "failed"
  detail    String?
  createdAt DateTime @default(now())

  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Email: password reset links and the outgoing mail queue
// ─────────────────────────────────────────────────────────────

model PasswordReset {
  id        String    @id @default(cuid()) @map("_id")
  userId    String
  tokenHash String    @unique // sha256 of the emailed token
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Outgoing email, queued in the same transaction as the event and sent by the mail job
model EmailMessage {
  id             String    @id @default(cuid()) @map("_id")
  tenantId       String? // null for platform mail (password reset)
  to             String
  subject        String
  text           String
  html           String
  template       String // "invite" | "password_reset" | "invoice_paid" | "support_reply" | "inbox_reply"
  // Email channel replies: the inbox message whose delivery status this decides
  inboxMessageId String?
  // Email channel replies: threading headers and the sending address
  from           String?
  headers        Json      @default("{}")
  status         String    @default("queued") // "queued" | "sending" | "sent" | "failed" | "not_sent" (no SMTP)
  attempts       Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
}
