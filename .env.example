# Copy to .env for local development. Production values come from the secret store.

# Application role: subject to Row Level Security (no BYPASSRLS, not table owner)
DATABASE_URL=postgresql://axis_app:axis_app@localhost:5433/axis
# Owner role: used only by migrations and seed
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/axis

# >= 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Used by apps/web to reach the API (server side only)
API_URL=http://localhost:4000
