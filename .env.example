# Copy to .env for local development. Production values come from the secret store.

# MongoDB replica set (transactions need one). `npm run db:start` runs it locally.
# Keep w=majority&journal=true: requests must see writes acknowledged just before them.
DATABASE_URL=mongodb://127.0.0.1:27018/axis?replicaSet=rs0&directConnection=true&w=majority&journal=true

# >= 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Auth requests per minute per client IP (production default 10). Raised locally
# because the UI test suite signs up many companies from one machine.
AUTH_RATE_LIMIT=200

# Used by apps/web to reach the API (server side only)
API_URL=http://localhost:4000

# Encrypts messaging-channel access tokens at rest (32 bytes, base64: `openssl rand -base64 32`)
CHANNEL_SECRET_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS1pbi1wcm9kISE=
# Meta app for WhatsApp Cloud API / Messenger / Instagram. Leave unset to use demo channels only;
# webhooks are rejected while META_APP_SECRET is missing.
# META_APP_SECRET=
# META_VERIFY_TOKEN=

# First platform Super Admin, created by `npm run db:seed` (password only set on creation).
# Demo seed also creates platform@demo.axis / support@demo.axis.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=

# Platform staff must turn on 2FA before using /admin (default: on in production)
# PLATFORM_REQUIRE_MFA=true

# Outgoing email. Without SMTP_URL nothing is sent: messages stay in the mail log as
# "not sent" (shown on /admin/system), invite links are shown in the UI instead.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Axis <no-reply@axis.az>"
# Public URL of the API, used in webhook addresses (email channel inbound)
# PUBLIC_API_URL=https://api.axis.az

# AI assistant (Claude). Without a key the AI buttons say it isn't connected.
# Directly from Anthropic:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# …or through OpenRouter (same Claude models, OpenRouter billing):
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# AI_MODEL=anthropic/claude-opus-5.5   (default per provider: claude-opus-5-5 / anthropic/claude-opus-5.5)
