{
  "name": "axis-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "test:api": "jest --runInBand",
    "test:ui": "playwright test",
    "db:start": "node scripts/db/dev-db.mjs",
    "db:seed": "node scripts/db/with-env.mjs node --experimental-strip-types --no-warnings scripts/db/seed.mjs",
    "db:indexes": "node scripts/db/with-env.mjs node scripts/db/indexes.mjs",
    "storage:migrate": "node scripts/storage/migrate-to-s3.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "3.700.0",
    "@node-rs/argon2": "2.0.2",
    "clsx": "2.1.1",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.469.0",
    "mongodb": "6.12.0",
    "next": "15.5.28",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/supertest": "6.0.2",
    "autoprefixer": "10.4.20",
    "axe-core": "^4.14.0",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.2",
    "postcss": "8.5.1",
    "supertest": "7.0.0",
    "tailwindcss": "3.4.17",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
